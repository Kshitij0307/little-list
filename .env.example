# Select local browser storage or the Supabase-backed cloud API.
APP_STORAGE_MODE=local

# Required only when APP_STORAGE_MODE=cloud.
# Server-only. Paste a modern Supabase secret key (sb_secret_...) into the key variable.
# Do not use the publishable key (sb_publishable_...); it cannot access our task table.
# The variable name is retained for compatibility; never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
