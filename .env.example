# local: browser-only notebook; cloud: Google login and private Supabase tasks.
APP_STORAGE_MODE=local

# Required in cloud mode. Use the publishable key, not a service-role secret.
# The Supabase SDK runs on the server, so no NEXT_PUBLIC_ variables are needed.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Exact app origin. Use your HTTPS domain on Vercel.
APP_URL=http://localhost:3000
